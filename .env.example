# API keys for the MCQ agent, one per line. Copy this file to .env and fill in the ones you use.
# setup.bat writes the Gemini key here for you. Keep .env to yourself: git ignores it, but a copy
# of the folder carries it along.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
# For --answer-provider: a stronger text model for scenario and code questions
OPENROUTER_API_KEY=
DEEPINFRA_API_KEY=
TOGETHER_API_KEY=
HF_TOKEN=
ZAI_API_KEY=
